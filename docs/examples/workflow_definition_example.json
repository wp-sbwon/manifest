{
  "name": "custom_workflow",
  "description": "Custom workflow example with conditional stages",
  "stages": [
    {
      "name": "planner",
      "agent_type": "planner",
      "condition": "always",
      "dependencies": [],
      "timeout": 300.0,
      "required": true
    },
    {
      "name": "tdd_test",
      "agent_type": "test",
      "condition": "on_success",
      "dependencies": ["planner"],
      "timeout": 300.0,
      "required": true
    },
    {
      "name": "coder",
      "agent_type": "coder",
      "condition": "on_success",
      "dependencies": ["tdd_test"],
      "timeout": 900.0,
      "required": true
    },
    {
      "name": "test",
      "agent_type": "test",
      "condition": "on_success",
      "dependencies": ["coder"],
      "timeout": 300.0,
      "required": true
    },
    {
      "name": "debug",
      "agent_type": "debug",
      "condition": "on_failure",
      "dependencies": ["test"],
      "timeout": 600.0,
      "required": false,
      "max_retries": 5
    },
    {
      "name": "self_review",
      "agent_type": "coder",
      "condition": "on_success",
      "dependencies": ["test"],
      "timeout": 300.0,
      "required": true
    },
    {
      "name": "approver",
      "agent_type": "approver",
      "condition": "on_success",
      "dependencies": ["self_review"],
      "timeout": 300.0,
      "required": true
    }
  ],
  "entry_points": ["planner"],
  "exit_points": ["approver"],
  "metadata": {
    "version": "1.0",
    "author": "Manifest"
  }
}
