{
  "version": "1.0",
  "type": "documentation_manifest",
  "metadata": {
    "title": "Manifest 프로젝트 문서",
    "description": "Manifest TUI MVP 프로젝트의 모든 문서를 구조화된 JSON 형태로 제공",
    "last_updated": "2026-01-20",
    "format": "strict_doc_view"
  },
  "project_overview": {
    "name": "Manifest",
    "vision": "AI-Native Orchestration IDE로 Code Blindness 문제 해결",
    "core_values": [
      "Visual Truth: 설계와 구현의 실시간 동기화",
      "Tiered Context: Mission Stage에 따른 계층적 컨텍스트 관리",
      "Drift Detection: 아키텍처와 코드 간 불일치 실시간 감지",
      "State Continuity: 세션 중단 후 정확한 재개"
    ],
    "current_phase": "phase1_tui_mvp",
    "status": "complete"
  },
  "architecture": {
    "layers": [
      {
        "id": "presentation",
        "name": "Presentation Layer",
        "description": "사용자 인터페이스 및 뷰 관리",
        "modules": [
          {
            "id": "app",
            "file": "app.py",
            "lines": 550,
            "responsibility": "TUI 애플리케이션 진입점 및 뷰 관리",
            "dependencies": ["config", "state_manager", "agent_bridge", "drift_auditor", "widgets"],
            "status": "complete"
          },
          {
            "id": "widgets",
            "file": "widgets.py",
            "lines": 260,
            "responsibility": "커스텀 Textual 위젯",
            "components": [
              {"id": "requirement_map", "name": "RequirementMap"},
              {"id": "architecture_graph", "name": "ArchitectureGraph"},
              {"id": "feature_tree", "name": "FeatureTree"},
              {"id": "task_tree", "name": "TaskTree"},
              {"id": "gate_controller", "name": "GateController"}
            ],
            "status": "complete"
          },
          {
            "id": "bootstrap_ui",
            "file": "bootstrap_ui.py",
            "responsibility": "API 키 설정 TUI",
            "status": "partial",
            "issues": ["nested_app_event_loop_conflict"]
          }
        ]
      },
      {
        "id": "business_logic",
        "name": "Business Logic Layer",
        "description": "비즈니스 로직 및 핵심 기능",
        "modules": [
          {
            "id": "state_manager",
            "file": "state_manager.py",
            "lines": 150,
            "responsibility": "애플리케이션 상태 영속성",
            "features": [
              "mission_tree_management",
              "task_checklist_management",
              "chat_history_management",
              "session_resumption"
            ],
            "status": "complete"
          },
          {
            "id": "agent_bridge",
            "file": "agent_bridge.py",
            "lines": 200,
            "responsibility": "Agent 시스템과의 직접 통합",
            "features": [
              "json_message_protocol",
              "async_message_handling",
              "command_interface",
              "agent_system_integration"
            ],
            "commands": ["start_mission", "get_status", "promote_task", "get_agent_output"],
            "status": "complete"
          },
          {
            "id": "drift_auditor",
            "file": "drift_auditor.py",
            "lines": 200,
            "responsibility": "아키텍처 드리프트 감지",
            "features": [
              "ast_parsing",
              "blueprint_comparison",
              "conflict_detection",
              "severity_levels"
            ],
            "severity_levels": ["error", "warning", "info"],
            "status": "complete"
          }
        ]
      },
      {
        "id": "infrastructure",
        "name": "Infrastructure Layer",
        "description": "인프라스트럭처 및 설정",
        "modules": [
          {
            "id": "config",
            "file": "config.py",
            "lines": 100,
            "responsibility": "API 키 관리 및 설정",
            "features": ["encrypted_key_storage", "key_validation", "bootstrap_mode"],
            "status": "complete"
          }
        ]
      }
    ],
    "data_flow": {
      "app_startup": [
        "ManifestApp.on_mount()",
        "ConfigManager.has_all_keys() 체크",
        "StateManager.load_state_async() 로드",
        "AgentBridge.start() 초기화",
        "Intent/Blueprint 데이터 로드",
        "각 뷰 업데이트",
        "DriftAuditor.audit_project() 실행"
      ],
      "user_input": [
        "on_input_submitted()",
        "입력 클리어",
        "StateManager.add_chat_message()",
        "process_command()",
        "명령 파싱 또는 AgentBridge 통신",
        "상태 저장",
        "입력 필드 포커스 복원"
      ],
      "drift_detection": [
        "DriftAuditor.audit_project()",
        "find_python_files() - Python 파일 찾기",
        "parse_python_file() - 각 파일 파싱",
        "compare_with_blueprint() - Blueprint 비교",
        "get_conflicts_by_severity() - 충돌 그룹화",
        "Inspector 뷰에 표시"
      ]
    }
  },
  "views": [
    {
      "id": "architect",
      "name": "Architect (Intention)",
      "description": "Visual intent map showing Features, Requirements, and User Goals",
      "data_source": "intent.json",
      "widgets": ["requirement_map"],
      "keyboard_shortcut": "Tab",
      "status": "complete"
    },
    {
      "id": "blueprint",
      "name": "Blueprint (Design)",
      "description": "Visual translation showing Classes/Methods/API contracts",
      "data_source": "blueprint.json",
      "widgets": ["architecture_graph"],
      "keyboard_shortcut": "Tab",
      "status": "complete"
    },
    {
      "id": "inspector",
      "name": "Inspector (Verification)",
      "description": "Context-sensitive verification with three modes",
      "modes": [
        {"id": "visual", "description": "UI Match display", "status": "complete"},
        {"id": "data", "description": "Execution trace and I/O flow", "status": "complete"},
        {"id": "drift", "description": "Architecture vs Code conflicts", "status": "complete"}
      ],
      "keyboard_shortcut": "I",
      "status": "complete"
    },
    {
      "id": "mission_control",
      "name": "Mission Control (Management)",
      "description": "Task tree with status indicators and approval gates",
      "widgets": ["task_tree", "gate_controller"],
      "status": "complete"
    },
    {
      "id": "history",
      "name": "History (Timeline)",
      "description": "Git-linked timeline for design and code changes",
      "data_source": "git_repository",
      "dependencies": ["GitPython"],
      "keyboard_shortcut": "H",
      "status": "complete"
    },
    {
      "id": "project_info",
      "name": "Project Info",
      "description": "프로젝트 아키텍처 및 상태 정보",
      "data_source": "project.json",
      "keyboard_shortcut": "P",
      "status": "complete"
    }
  ],
  "data_models": {
    "state": {
      "file": "state.json",
      "schema": {
        "version": "string",
        "mission_tree": "object",
        "task_checklist": "array",
        "chat_history": "object",
        "last_action": "string",
        "timestamp": "string"
      },
      "description": "애플리케이션 세션 상태"
    },
    "intent": {
      "file": "intent.json",
      "schema": {
        "version": "string",
        "sprint": "string",
        "features": "array"
      },
      "description": "프로젝트 의도 및 기능 정의"
    },
    "blueprint": {
      "file": "blueprint.json",
      "schema": {
        "version": "string",
        "zones": {
          "client": "array",
          "server": "array",
          "data": "array"
        },
        "components": "array",
        "contracts": "array"
      },
      "description": "기술 설계 및 컴포넌트 구조"
    },
    "architecture": {
      "file": "architecture.json",
      "schema": {
        "version": "string",
        "features": "array",
        "requirements": "array",
        "goals": "array"
      },
      "description": "아키텍처 스펙"
    },
    "project": {
      "file": "project.json",
      "schema": {
        "version": "string",
        "type": "string",
        "metadata": "object",
        "architecture": "object",
        "views": "array",
        "implementation_status": "object"
      },
      "description": "프로젝트 전체 아키텍처 및 상태"
    }
  },
